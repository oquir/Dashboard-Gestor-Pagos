{
  "name": "gestor-pagos-monorepo",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "dev:dashboard": "pnpm --filter dashboard-gestor-pagos dev",
    "dev:formularios": "pnpm --filter form-maker dev",
    "build": "pnpm --recursive build",
    "preview": "pnpm --recursive --parallel preview",
    "preview:dashboard": "pnpm --filter dashboard-gestor-pagos preview",
    "preview:formularios": "pnpm --filter form-maker preview",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.0"
  }
}
